# ha-pellmon runtime configuration — copy to .env and chmod 600.
# .env is gitignored; NEVER commit real values.

# ── Furnace (NBE controller — values from furnace menu 18) ──
NBE_SERIAL=
NBE_PASSWORD=
# Controller IP (recommended: DHCP reservation). Required with the
# default docker bridge network — broadcast discovery does not cross it.
NBE_ADDR=
#NBE_PORT=8483
#POLL_INTERVAL=10
# Broadcast discovery is refused unless you opt in here, and even then
# the write path stays disabled (the first responder is unauthenticated).
# Leave this off and set NBE_ADDR instead.
#NBE_ALLOW_BROADCAST=false

# ── MQTT client (the bridge) ──
# Default: the Home Assistant Mosquitto add-on. Set MQTT_HOST to your HA
# host (IP or DNS name) and create a dedicated HA user for the bridge
# (Settings → People → Users, or the add-on's `logins:` option). Apply
# mosquitto/acl.example through the add-on's "customize" ACL so the
# bridge credential cannot publish commands.
MQTT_HOST=<ha-host>
MQTT_PORT=1883
MQTT_USERNAME=pellmon-bridge
MQTT_PASSWORD=
# The add-on serves plaintext 1883 by default. Enable TLS if you have
# configured certificates on the add-on (port 8883) — or use the bundled
# hardened broker instead: `docker compose --profile broker up -d` with
# MQTT_HOST=mosquitto MQTT_PORT=8883 MQTT_TLS=true.
MQTT_TLS=false
#MQTT_TLS_CA=/config/certs/ca.crt
# Optional mutual TLS:
#MQTT_TLS_CERT=/config/certs/bridge.crt
#MQTT_TLS_KEY=/config/certs/bridge.key

# Explicit opt-out only — the bridge refuses to start without
# credentials unless you consciously accept anonymous MQTT:
#MQTT_ALLOW_ANONYMOUS=false

# ── Logging ──
BRIDGE_LOGLEVEL=INFO
