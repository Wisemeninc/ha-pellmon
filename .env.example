# ha-pellmon runtime configuration — copy to .env and chmod 600.
# .env is gitignored; NEVER commit real values.

# ── Furnace (NBE controller — values from furnace menu 18) ──
NBE_SERIAL=
NBE_PASSWORD=
# Controller IP (recommended: DHCP reservation). Required with the
# default docker bridge network — broadcast discovery does not cross it.
NBE_ADDR=
#NBE_PORT=8483
#POLL_INTERVAL=10

# ── MQTT client (the bridge) ──
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USERNAME=pellmon-bridge
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_TLS_CA=/config/certs/ca.crt
# Optional mutual TLS:
#MQTT_TLS_CERT=/config/certs/bridge.crt
#MQTT_TLS_KEY=/config/certs/bridge.key

# Explicit opt-out only — the bridge refuses to start without
# credentials unless you consciously accept anonymous MQTT:
#MQTT_ALLOW_ANONYMOUS=false

# ── Logging ──
BRIDGE_LOGLEVEL=INFO
